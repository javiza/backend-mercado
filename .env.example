# Copia este archivo a .env (local). En producción se configuran en el panel del hosting (o vía render.yaml).
PORT=3001
# Local con Docker: postgres://postgres:postgres@localhost:5432/supermercado
DATABASE_URL=postgres://usuario:clave@localhost:5432/supermercado
# true si usas la URL EXTERNA de Render; false con la URL interna o Postgres local
DB_SSL=false
JWT_SECRET=cambia-esto-por-un-secreto-largo
JWT_REFRESH_SECRET=cambia-esto-por-otro-secreto-largo
CORS_ORIGIN=http://localhost:3000
# Cuenta inicial (se crea sola la primera vez que arranca)
SEED_ADMIN_EMAIL=admin@supermercado.cl
SEED_ADMIN_PASSWORD=cambia-esta-clave
SEED_ADMIN_NOMBRE=Administrador

# ── Base de datos ─────────────────────────────────────────────
# Las migraciones se aplican solas al arrancar. Ponlo en false si migras en el preDeployCommand de Render.
DB_MIGRATIONS_RUN=true
# Solo prototipos: crea tablas desde las entidades (NO usar junto con migraciones en producción)
# DB_SYNC=false
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_SLOW_QUERY_MS=500

# ── Redis (opcional: sin esto la app funciona igual, solo sin caché ni eventos por Redis) ──
# Render Key Value: usa la URL INTERNA. Local: redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# ── Reportes (vistas materializadas) ──────────────────────────
# Cada cuántos ms se refrescan las vistas (300000 = 5 min; 0 = desactivado)
# ANALYTICS_REFRESH_MS=300000

# ── Eventos (outbox → Redis Streams o Kafka) ──────────────────
# EVENT_BUS=redis          # redis | kafka | none  (por defecto: kafka si hay KAFKA_BROKERS, si no redis si hay REDIS_URL)
# OUTBOX_POLL_MS=2000
# OUTBOX_RETENTION_DAYS=7
# Solo si usas Kafka (Upstash, Confluent Cloud, Redpanda Cloud, etc.; Render no ofrece Kafka propio):
# KAFKA_BROKERS=broker1:9092,broker2:9092
# KAFKA_TOPIC=supermercado.eventos
# KAFKA_SSL=true
# KAFKA_USERNAME=
# KAFKA_PASSWORD=
# KAFKA_SASL_MECHANISM=scram-sha-256
