# Copia este archivo a .env (local). En producción se configuran en el panel del hosting.
PORT=3001
DATABASE_URL=postgres://postgres:postgres@localhost:5432/supermercado
DB_SSL=false
JWT_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio
JWT_REFRESH_SECRET=cambia-esto-por-otro-texto-largo-y-aleatorio
CORS_ORIGIN=http://localhost:3000
# Cuenta inicial (se crea sola la primera vez que arranca)
SEED_ADMIN_EMAIL=admin@supermercado.cl
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_NOMBRE=Administrador
